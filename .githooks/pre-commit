#!/usr/bin/env bash
# Crochet pre-commit Fisca (Doc_15 § 10). Activé par scripts/bootstrap-sandbox.sh : git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "[pre-commit] garde de constitution (périmètre, gouvernance, branche)…"
node scripts/enforce-constitution.ts

echo "[pre-commit] porte statique harness-check…"
bash scripts/harness-check.sh

echo "[pre-commit] pnpm verify:fast…"
pnpm verify:fast
