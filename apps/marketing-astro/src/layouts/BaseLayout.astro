---
import '../styles/tokens.css';
import '../styles/base.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { CNDP_REFERENCES, DATA_CONTROLLER, hasCndpNumber } from '../content/cndp.ts';
import type { CatalogOffer } from '../content/pricing.ts';
import { PRICING_SLUG, PRIVACY_SLUG } from '../content/pages.ts';
import { usesFrenchFallback } from '../i18n/copy-locale.ts';
import { buildPageHead } from '../i18n/head.ts';
import { LOCALE_URL_PREFIX } from '../i18n/locales.ts';
import type { MarketingLocale } from '../i18n/locales.ts';
import { FALLBACK_NOTICE, getSiteCopy } from '../i18n/site-copy.ts';
import { SILOS } from '../content/silos/registry.ts';
import { CGNC_HUB_SLUG } from '../content/cgnc/registry.ts';
import { HUB_TITLE, cgncLocaleOf } from '../content/cgnc/copy.ts';
import { COMMON, TOOLS_HUB_SLUG } from '../tools/copy/common.ts';
import { UI } from '../content/silos/ui-copy.ts';
import { copyLocaleOf } from '../i18n/copy-locale.ts';
import { buildFiscaJsonLdGraph } from '../seo/jsonld.ts';
import type { FaqPair, HowToInput, LegislationRef } from '../seo/jsonld.ts';

interface Props {
  locale: MarketingLocale;
  slug: string;
  title: string;
  description: string;
  legislation?: LegislationRef;
  howTo?: HowToInput;
  faqs?: readonly FaqPair[];
  catalogOffers?: readonly CatalogOffer[];
  /** Page sous le seuil de qualité (Doc_18 S10) : noindex, follow. */
  noindex?: boolean;
}

const { locale, slug, title, description, legislation, howTo, faqs, catalogOffers, noindex } = Astro.props;
const head = buildPageHead(locale, slug, { title, description });
const site = getSiteCopy(locale);
const prefix = LOCALE_URL_PREFIX[locale];
const fallback = usesFrenchFallback(locale);
const jsonLd = buildFiscaJsonLdGraph({
  pageUrl: head.canonical,
  locale,
  title,
  description,
  ...(legislation === undefined ? {} : { legislation }),
  ...(howTo === undefined ? {} : { howTo }),
  ...(faqs === undefined ? {} : { faqs }),
  ...(catalogOffers === undefined ? {} : { catalogOffers }),
});
const cndpNumbers = CNDP_REFERENCES.filter(hasCndpNumber);
const copyLocale = copyLocaleOf(locale);
const guideLinks = [
  ...SILOS.map((silo) => ({ href: `/${prefix}/${silo.slug}`, label: silo.title[copyLocale] })),
  { href: `/${prefix}/${CGNC_HUB_SLUG}`, label: HUB_TITLE[cgncLocaleOf(locale)] },
];
const current = slug.replace(/^\/+|\/+$/g, '');
const navItems = [
  { href: `/${prefix}/`, label: site.navHome, active: current === '' },
  { href: `/${prefix}/${PRICING_SLUG}`, label: site.navPricing, active: current === PRICING_SLUG },
  { href: `/${prefix}/${TOOLS_HUB_SLUG}`, label: COMMON.toolsLabel[copyLocale], active: current === TOOLS_HUB_SLUG || current.startsWith(`${TOOLS_HUB_SLUG}/`) },
  { href: `/${prefix}/${PRIVACY_SLUG}`, label: site.navPrivacy, active: current === PRIVACY_SLUG },
];
---
<html lang={head.htmlLang} dir={head.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{head.title}</title>
    <meta name="description" content={head.description} />
    <meta name="color-scheme" content="light dark" />
    {noindex === true && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={head.canonical} />
    {head.alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={head.title} />
    <meta property="og:description" content={head.description} />
    <meta property="og:url" content={head.canonical} />
    <meta property="og:locale" content={head.htmlLang} />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body lang={fallback ? 'fr' : undefined}>
    <a class="skip-link" href="#contenu">{site.skipLink}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={`/${prefix}/`} aria-label={site.brandLabel}>Fisca</a>
        <nav aria-label={site.navLabel}>
          <ul class="nav-list">
            {navItems.map((item) => (
              <li><a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <LanguageSwitcher current={locale} slug={slug} label={site.languageLabel} />
      </div>
    </header>
    <main id="contenu" class="container">
      {fallback && (
        <div class="notice" role="note">
          <p lang="fr">{FALLBACK_NOTICE.fr}</p>
          <p lang="ar" dir="rtl">{FALLBACK_NOTICE.ar}</p>
        </div>
      )}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p><strong>Fisca</strong> · {site.footerPublisherLabel} : {DATA_CONTROLLER.legalName}, {DATA_CONTROLLER.locality}</p>
        <p>
          {site.footerContactLabel} : <a href={`mailto:${DATA_CONTROLLER.contactEmail}`} dir="ltr">{DATA_CONTROLLER.contactEmail}</a>
          · {site.footerLawLabel} : {site.footerLawValue}
        </p>
        <p>
          {site.cndpReferenceLabel} :
          {cndpNumbers.length === 0
            ? <span class="pending">{site.cndpPending}</span>
            : cndpNumbers.map((ref) => <span class="fisca-tabular-num" dir="ltr"> {ref.form} {ref.number} </span>)}
        </p>
        <p>{site.footerNoTracking}</p>
        <p>{site.footerPriceNote}</p>
        <ul class="footer-links">
          {navItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
        <nav aria-label={UI.guides[copyLocale]}>
          <ul class="footer-links">
            {guideLinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
