---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiloArticle from '../../components/SiloArticle.astro';
import { SILOS, buildHubView, buildSiloViewBySlug } from '../../content/silos/registry.ts';
import { localeFromPrefix } from '../../i18n/locales.ts';

const locale = localeFromPrefix(Astro.params['locale']);
const slug = (Astro.params['slug'] ?? '').replace(/^\/+|\/+$/g, '');
if (locale === null) {
  return new Response(null, { status: 404 });
}
const hubSilo = SILOS.find((s) => s.slug === slug);
const view = hubSilo === undefined ? buildSiloViewBySlug(locale, slug) : undefined;
if (hubSilo === undefined && view === undefined) {
  return new Response(null, { status: 404 });
}
const hub = hubSilo === undefined ? undefined : buildHubView(locale, hubSilo.id);
const noindex = view !== undefined && !view.quality.indexable;
if (noindex) Astro.response.headers.set('X-Robots-Tag', 'noindex, follow');
---
{view !== undefined && (
  <BaseLayout
    locale={locale}
    slug={view.slug}
    title={view.title}
    description={view.description}
    noindex={noindex}
    faqs={view.faqs}
    {...(view.legislation === null ? {} : { legislation: view.legislation })}
    {...(view.steps.length === 0 ? {} : { howTo: { name: view.labels.howToName, steps: view.steps } })}
  >
    <SiloArticle view={view} />
  </BaseLayout>
)}
{hub !== undefined && (
  <BaseLayout locale={locale} slug={hub.slug} title={hub.title} description={hub.description}>
    <nav class="breadcrumb" aria-label={hub.breadcrumbLabel}>
      <ol>
        {hub.breadcrumb.map((crumb, index) => (
          <li><a href={crumb.href} aria-current={index === hub.breadcrumb.length - 1 ? 'page' : undefined}>{crumb.label}</a></li>
        ))}
      </ol>
    </nav>
    <h1>{hub.title}</h1>
    <p class="lead">{hub.lead}</p>
    <section class="section" aria-labelledby="pages">
      <h2 id="pages">{hub.headingPages}</h2>
      <ul class="hub-list">
        {hub.entries.map((entry) => (
          <li>
            <a href={entry.href}>{entry.label}</a>
            <p>{entry.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  </BaseLayout>
)}
