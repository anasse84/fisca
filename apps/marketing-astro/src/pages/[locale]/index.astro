---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getHomeCopy } from '../../i18n/home-copy.ts';
import { MARKETING_LOCALES, LOCALE_URL_PREFIX, localeFromPrefix } from '../../i18n/locales.ts';

const locale = localeFromPrefix(Astro.params.locale);
if (locale === null) {
  return new Response(null, { status: 404 });
}
const copy = getHomeCopy(locale);
---
<BaseLayout locale={locale} slug="" title={copy.title} description={copy.description}>
  <h1>{copy.heading}</h1>
  <p class="lead">{copy.lead}</p>
  <ul class="lang-nav">
    {MARKETING_LOCALES.map((loc) => (
      <li><a href={`/${LOCALE_URL_PREFIX[loc]}/`} hreflang={loc}>{loc}</a></li>
    ))}
  </ul>
</BaseLayout>
